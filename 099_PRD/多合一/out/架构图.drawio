      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nflowchart TB\n    subgraph POWER[\&quot;① 能源管理状态机\&quot;]\n        PV[\&quot;OPV历史补能曲线\&quot;]\n        CAP[\&quot;20F超容：电压、SOC、衰减\&quot;]\n        CELL[\&quot;600mAh纽扣电池：SOC、负载电压\&quot;]\n        USB[\&quot;Type-C外部供电\&quot;]\n        PV --&gt; FORECAST[\&quot;短期能量预测\&quot;]\n        CAP --&gt; FORECAST\n        CELL --&gt; FORECAST\n        USB --&gt; FORECAST\n        CAP --&gt; PS{\&quot;超容是否低于2.6V\&quot;}\n        PS --&gt;|否| CP[\&quot;超容主供电\&quot;]\n        PS --&gt;|是| BP[\&quot;切换电池并产生供电事件\&quot;]\n        BP --&gt;|超容恢复到切回阈值| CP\n        CP --&gt; FORECAST\n        BP --&gt; FORECAST\n        FORECAST --&gt; WINDOW[\&quot;生成雷达窗口与占空比预算\&quot;]\n        FORECAST --&gt; RESERVE{\&quot;预测剩余正常续航＜12h？\&quot;}\n    end\n\n    subgraph SENSE[\&quot;② PIR与雷达双鉴状态机\&quot;]\n        SLEEP[\&quot;8258深睡；PIR持续监测；雷达待机\&quot;]\n        SLEEP --&gt;|PIR有效中断| WAKE[\&quot;唤醒8258；记录PIR运动证据\&quot;]\n        SLEEP --&gt;|空闲满2h| HEART[\&quot;自唤醒；发送心跳\&quot;]\n        WAKE --&gt; CHECK{\&quot;允许启动雷达？\&quot;}\n        CHECK --&gt;|允许| RADAR[\&quot;按窗口策略启动24GHz雷达\&quot;]\n        RADAR --&gt; DUAL{\&quot;PIR运动证据与雷达目标证据匹配？\&quot;}\n        DUAL --&gt;|是| PRESENT[\&quot;确认有人\&quot;]\n        DUAL --&gt;|否或超时| REJECT[\&quot;双鉴失败或证据不足\&quot;]\n        PRESENT --&gt; KEEP[\&quot;按能源预算持续或周期复核\&quot;]\n        KEEP --&gt; KRESULT{\&quot;有效存在检测结果\&quot;}\n        KRESULT --&gt;|仍有人| PRESENT\n        KRESULT --&gt;|连续有效复核为无人| VACANT[\&quot;确认无人\&quot;]\n        KRESULT --&gt;|证据过期或停测| UNKNOWN[\&quot;状态未知\&quot;]\n        REJECT --&gt; SLEEP\n        VACANT --&gt; SLEEP\n        UNKNOWN --&gt;|恢复有效检测| KEEP\n    end\n\n    WINDOW -.-&gt;|窗口参数| RADAR\n    WINDOW -.-&gt;|运行占空比| KEEP\n    RESERVE --&gt;|否| CHECK\n    RESERVE --&gt;|是| PREP[\&quot;保电准备；生成告警\&quot;]\n    PREP --&gt; PWAIT[\&quot;请求父节点持久化确认\&quot;]\n    PWAIT --&gt;|确认或重试处理完成| PROTECT[\&quot;执行经批准的保电策略\&quot;]\n    PROTECT --&gt;|能源恢复且达到重启条件| SLEEP\n\n    subgraph LOCAL[\&quot;③ 本地直达联动：不经过父节点\&quot;]\n        LE[\&quot;本地BLE联动事件\&quot;]\n        ACT[\&quot;灯具／空调控制器／其他执行端\&quot;]\n        LE --&gt;|设备或分组直达| ACT\n        ACT -.-&gt;|若协议支持，返回执行反馈| LE\n    end\n\n    subgraph CLOUD[\&quot;④ 父节点与云端通信\&quot;]\n        QUEUE[\&quot;带事件ID与时间戳的上报队列\&quot;]\n        PARENT[\&quot;父节点\&quot;]\n        GW[\&quot;集中器／网关\&quot;]\n        CLOUDP[\&quot;澜潮云平台\&quot;]\n        MINI[\&quot;微信小程序\&quot;]\n        QUEUE --&gt;|BLE上报| PARENT\n        PARENT --&gt;|接收ACK| QUEUE\n        PARENT --&gt; GW\n        GW &lt;--&gt;|MQTT/TLS| CLOUDP\n        CLOUDP &lt;--&gt;|配置、状态、记录| MINI\n        PARENT -.-&gt;|缓存云端配置，待节点可接收时下发| QUEUE\n    end\n\n    WAKE --&gt;|PIR触发事件| QUEUE\n    HEART --&gt;|心跳及能源摘要| QUEUE\n    PRESENT --&gt;|有效有人联动| LE\n    VACANT --&gt;|有效无人联动| LE\n    PRESENT --&gt;|有人状态变化| QUEUE\n    VACANT --&gt;|无人状态变化| QUEUE\n    REJECT --&gt;|失败统计| QUEUE\n    UNKNOWN --&gt;|检测能力变化| QUEUE\n    CP --&gt;|供电状态| QUEUE\n    BP --&gt;|供电切换事件| QUEUE\n    PREP --&gt; QUEUE\n    PWAIT --&gt; QUEUE      &quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="JbzKb4ZmpD0aQAMKxywD-1">
